{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "rootDir": "./cubism-sdk-5-r.5/Framework/src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "useUnknownInCatchVariables": true,
    "skipLibCheck": true
  },
  "include": [
    "./cubism-sdk-5-r.5/Framework/src/**/*.ts",
    "./cubism-sdk-5-r.5/Core/*.d.ts"
  ],
  "exclude": ["./dist"]
}
